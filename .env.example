# ==========================================
# Configuración del Entorno de mcp-servers
# ==========================================

# 1. Base de Datos / Admin
# Contraseña para crear el administrador en la primera ejecución
PATHWISE_ADMIN_PASSWORD=change_me_to_a_secure_password

# Ruta de la base de datos (Opcional, por defecto pathwise.db en root)
# DB_PATH=./pathwise.db

# 2. Filesystem MCP
# Ruta permitida para las operaciones del Filesystem MCP (OBLIGATORIA)
ALLOWED_PATH=/ruta/absoluta/a/directorio/permitido

# 3. GitHub MCP
# Token personal de GitHub para interactuar con repositorios
GITHUB_TOKEN=ghp_tuto_ken_aqui_xxxx

# 4. RouteMCP / Inteligencia Artificial
# Indica si el enrutador MCP está activado para los demás servicios (true/false)
ROUTEMCP_ENABLED=true
# URL de despliegue o ejecución local de RouteMCP (por defecto localhost:8000)
# ROUTEMCP_URL=http://localhost:8000

# 5. Motores de Navegación (Browser MCP)
# Opciones: playwright, selenium, static, auto
BROWSER_ENGINE=auto

# Tamaño máximo del screenshot en bytes (por defecto 5MB)
BROWSER_SCREENSHOT_MAX_BYTES=5242880
