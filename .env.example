# Copy this file to .env and fill in your values before running docker-compose.

# RouteMCP — at least one key required for AI routing to work
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=

# LinkedInMCP — required for LinkedIn automation
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# GitHub MCP — required (create at https://github.com/settings/tokens)
GITHUB_TOKEN=
