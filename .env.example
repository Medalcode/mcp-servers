# =============================================================================
# medalcode-mcp-servers — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The servers load .env automatically on startup (python-dotenv).

# --- RouteMCP (AI Router) ---
GEMINI_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=

# --- BrowserMCP ---
BROWSER_ENGINE=selenium
BROWSER_HEADLESS=false
CHROME_DEBUG_PORT=9226
SELENIUM_REMOTE_URL=

# --- GitHubMCP ---
GITHUB_TOKEN=

# --- LinkedInMCP ---
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# --- EmailMCP ---
GMAIL_ACCESS_TOKEN=

# --- DocMCP ---
DOCMCP_WORKDIR=

# --- Pathwise ---
PATHWISE_BROWSERMCP_PATH=
